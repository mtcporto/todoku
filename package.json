{
  "name": "todoku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate.ts",
    "db:provision": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/provision-application.ts",
    "smoke:ingestion": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/smoke-ingestion.ts",
    "db:provider": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/configure-provider.ts",
    "smoke:delivery": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/smoke-delivery.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svix": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^6.0.0"
  }
}

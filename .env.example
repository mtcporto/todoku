# Server only. Select and inspect the intended database before applying migrations.
TURSO_DATABASE_URL=libsql://your-todoku-database.turso.io
TURSO_AUTH_TOKEN=

# Mail starts paused; configure private storage and approve DNS before enabling.
TODOKU_MAIL_RECEIVING_ENABLED=false
# Independent from Receiving and Notifications. Never enable before approval.
TODOKU_MAIL_SENDING_ENABLED=false
TODOKU_MAIL_STORAGE=disabled
TODOKU_MAIL_ORIGIN=https://todoku.com.br
# Google sign-in stays off until the additive migration, client and owner link are validated.
TODOKU_GOOGLE_OIDC_ENABLED=false
# TODOKU_GOOGLE_CLIENT_ID=
# TODOKU_GOOGLE_CLIENT_SECRET=
# Existing immutable mail_users.id, never a Google sub or email address.
# TODOKU_GOOGLE_OWNER_USER_ID=
# Pilot login gate only; mailbox access still comes from identity grants.
# TODOKU_GOOGLE_ALLOWED_EMAIL=
# TODOKU_R2_ACCOUNT_ID=
# TODOKU_R2_BUCKET=
# TODOKU_R2_ACCESS_KEY_ID=
# TODOKU_R2_SECRET_ACCESS_KEY=
# No global ingestion key. Per-application tokens are hashed in application_credentials.
# Provision using npm run db:provision; keep generated .env.credential.*.local private.
# Server-only encryption keyring: JSON mapping key IDs to 32-byte base64 keys.
# Generate securely; never use these placeholder values.
TODOKU_MASTER_KEYS={}
TODOKU_ACTIVE_MASTER_KEY=
# Random server-only worker credential (at least 32 characters).
CRON_SECRET=
# GET/cron always dry-run. POST test sending also requires an allowlisted scope/budget.
TODOKU_TEST_SEND_ENABLED=false
# Provisioning only, never a global delivery fallback. Prefer process environment
# or an existing authenticated operator context; never put values in Git or arguments.
# RESEND_MANAGEMENT_KEY=
# RESEND_APPLICATION_KEY=
# RESEND_APPLICATION_WEBHOOK_SECRET=
# TODOKU_SENDER_EMAIL=
# TODOKU_SENDER_NAME=Todoku
# TODOKU_RESEND_DOMAIN_ID=
# TODOKU_TEST_RECIPIENTS=[]
# TODOKU_TEST_AUTHORIZED=false
# Mail outbound provisioning only: separate sending-scoped key, never RESEND_API_KEY.
# RESEND_MAIL_SENDING_KEY=
# RESEND_MAIL_SENDING_WEBHOOK_SECRET=
# TODOKU_MAIL_SEND_RECIPIENTS=[]
# TODOKU_MAIL_SEND_DAILY_LIMIT=20
# TODOKU_MAIL_SENDING_AUTHORIZED=false
